{
  "name": "dnswitch",
  "version": "1.0.0",
  "description": "View and switch Windows DNS settings for your Wi-Fi connection",
  "license": "MIT",
  "author": "hoomanmesal",
  "homepage": "https://github.com/hoomanmesal/DNSwitch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoomanmesal/DNSwitch.git"
  },
  "bugs": {
    "url": "https://github.com/hoomanmesal/DNSwitch/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/backend.test.js",
    "test:layout": "node tests/layout.test.js",
    "test:live": "set LIVE=1&& node --test tests/backend.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.14.0"
  },
  "build": {
    "appId": "com.hoomanmesal.dnswitch",
    "productName": "DNSwitch",
    "copyright": "Copyright (c) 2026 hoomanmesal",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DNSwitch",
      "artifactName": "DNSwitch-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "DNSwitch-${version}-portable.${ext}"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
