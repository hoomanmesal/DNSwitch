{
  "name": "dnswitch",
  "version": "1.0.0",
  "description": "View and switch Windows DNS settings for your Wi-Fi connection",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.dnswitch",
    "productName": "DNSwitch",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "portable" }
  }
}
