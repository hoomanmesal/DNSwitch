{
  "name": "dnswitch",
  "version": "1.0.0",
  "description": "View and switch Windows DNS settings for your Wi-Fi connection",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/backend.test.js",
    "test:live": "set LIVE=1&& node --test tests/backend.test.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.14.0"
  },
  "build": {
    "appId": "com.local.dnswitch",
    "productName": "DNSwitch",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    }
  }
}
